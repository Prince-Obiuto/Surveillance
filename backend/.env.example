PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
# Set to the exact number of trusted reverse proxies in front of Express.
# Use 1 for one Nginx proxy only when the backend cannot be reached directly
# and Nginx overwrites/appends X-Forwarded-For. Keep 0 for direct app access.
TRUST_PROXY_HOPS=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=surveillance_db

VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
